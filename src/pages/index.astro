---
const projects = [
  {
    title: "Telco Churn Analysis",
    category: "Business Intelligence",
    description:
      "An end-to-end telecommunications customer churn analysis using Python, Power BI, and data visualization to identify churn patterns, customer segments, retention risks, and actionable business opportunities.",
    tags: ["Power BI", "Python", "Data Analytics", "Customer Retention"],
    href: "https://github.com/SuhCPortfolio/telco-churn-analysis",
  },
  {
    title: "Sales Performance Dashboard",
    category: "Data Visualization",
    description:
      "An interactive sales analytics dashboard designed to help management monitor revenue, order performance, product performance, payment methods, and business trends.",
    tags: ["Power BI", "Excel", "Data Visualization"],
    href: "#contact",
  },
  {
    title: "Business Analytics Case Studies",
    category: "Business Analysis",
    description:
      "A growing collection of practical analytics case studies focused on transforming business data into actionable insights and recommendations.",
    tags: ["Business Analysis", "Analytics", "Strategy"],
    href: "#contact",
  },
];
const skills = [
  {
    name: "Power BI",
    description: "Interactive dashboards, KPIs and business intelligence",
  },
  {
    name: "Excel",
    description: "Data analysis, reporting and business modeling",
  },
  {
    name: "SQL",
    description: "Data querying, transformation and analysis",
  },
  {
    name: "Python",
    description: "Data analysis, exploration and automation",
  },
  {
    name: "Business Analysis",
    description: "Business problems, insights and strategic recommendations",
  },
  {
    name: "Data Visualization",
    description: "Clear visual storytelling for decision-makers",
  },
];

const navItems = [
  ["Home", "#home"],
  ["About", "#about"],
  ["Skills", "#skills"],
  ["Projects", "#projects"],
  ["Experience", "#experience"],
  ["Contact", "#contact"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Portfolio of Suh Cheo Cyprain — Business Analyst, Data Analytics and Business Intelligence professional."
    />
    <meta
      name="keywords"
      content="Suh Cheo Cyprain, Business Analyst, Data Analytics, Power BI, Business Intelligence, SQL, Python, Excel"
    />
    <meta name="author" content="Suh Cheo Cyprain" />

    <title>Suh Cheo Cyprain | Business Analyst & Data Analytics</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <!-- =========================
         NAVIGATION
    ========================== -->
    <header class="site-header">
      <nav class="nav container">
        <a href="#home" class="brand" aria-label="Suh Cheo Cyprain home">
          <span class="brand-mark">SC</span>
          <span class="brand-name">Suh Cheo Cyprain</span>
        </a>

        <div class="nav-links">
          {
            navItems.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))
          }
        </div>

        <a href="#contact" class="nav-cta">Let's Connect</a>
      </nav>
    </header>

    <main>
      <!-- =========================
           HERO
      ========================== -->
      <section id="home" class="hero">
        <div class="hero-glow hero-glow-one"></div>
        <div class="hero-glow hero-glow-two"></div>

        <div class="container hero-grid">
          <div class="hero-content">
            <p class="eyebrow">
              <span class="status-dot"></span>
              Business Analyst · Data Analytics · Business Intelligence
            </p>

            <h1>
              Turning
              <span class="gradient-text">data</span>
              into better business decisions.
            </h1>

            <p class="hero-description">
              I'm <strong>Suh Cheo Cyprain</strong>, a Business Analyst and
              data-driven professional focused on transforming complex
              information into clear insights, practical recommendations and
              measurable business value.
            </p>

            <div class="hero-actions">
              <a href="#projects" class="button button-primary">
                View My Projects
                <span>→</span>
              </a>

              <a href="#contact" class="button button-secondary">
                Let's Connect
              </a>
            </div>

            <div class="hero-stats">
              <div>
                <strong>15+</strong>
                <span>Analytics Dashboards</span>
              </div>

              <div>
                <strong>10+</strong>
                <span>Years Leadership</span>
              </div>

              <div>
                <strong>50K</strong>
                <span>Annual Budget Managed</span>
              </div>
            </div>
          </div>

          <div class="hero-card">
            <div class="profile-card">
              <div class="profile-top">
                <div class="profile-avatar">SC</div>

                <div>
                  <span class="profile-label">PROFILE</span>
                  <h2>Business Analytics</h2>
                </div>
              </div>

              <div class="profile-line"></div>

              <div class="profile-item">
                <span>01</span>
                <div>
                  <strong>Analyze</strong>
                  <p>Understand the business problem.</p>
                </div>
              </div>

              <div class="profile-item">
                <span>02</span>
                <div>
                  <strong>Visualize</strong>
                  <p>Turn data into meaningful insights.</p>
                </div>
              </div>

              <div class="profile-item">
                <span>03</span>
                <div>
                  <strong>Recommend</strong>
                  <p>Translate insights into action.</p>
                </div>
              </div>

              <div class="profile-footer">
                <span>Business Intelligence</span>
                <span>✦</span>
                <span>Strategic Thinking</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           ABOUT
      ========================== -->
      <section id="about" class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">01 — About Me</p>
            <h2>Business thinking backed by data.</h2>
          </div>

          <div class="about-grid">
            <div class="about-intro">
              <p class="large-text">
                I combine <strong>business administration, analytics and
                leadership</strong> to solve practical problems and help
                organizations make more informed decisions.
              </p>

              <p>
                My approach starts with understanding the business question,
                examining the data, identifying meaningful patterns and
                translating those findings into recommendations that
                stakeholders can actually use.
              </p>

              <p>
                My experience spans business analysis, nonprofit leadership,
                entrepreneurship, strategic management and data analytics.
                This combination allows me to look beyond the numbers and
                understand the business context behind them.
              </p>
            </div>

            <div class="about-details">
              <div class="detail-card">
                <span>Education</span>
                <strong>Bachelor of Business Administration</strong>
                <p>University of the People · June 2025</p>
              </div>

              <div class="detail-card">
                <span>Focus</span>
                <strong>Business Analytics & BI</strong>
                <p>Power BI · Excel · SQL · Python</p>
              </div>

              <div class="detail-card">
                <span>Approach</span>
                <strong>Insight → Strategy → Action</strong>
                <p>Data-driven decision support</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
           SKILLS
      ========================== -->
      <section id="skills" class="section section-dark">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">02 — Skills</p>
            <h2>Tools I use to solve business problems.</h2>
          </div>

          <div class="skills-grid">
            {
              skills.map((skill, index) => (
                <article class="skill-card">
                  <span class="skill-number">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <h3>{skill.name}</h3>
                  <p>{skill.description}</p>

                  <span class="skill-arrow">↗</span>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================
           PROJECTS
      ========================== -->
      <section id="projects" class="section">
        <div class="container">
          <div class="section-heading projects-heading">
            <div>
              <p class="eyebrow">03 — Selected Projects</p>
              <h2>Work that turns data into insight.</h2>
            </div>

            <p>
              A selection of practical analytics and business intelligence
              projects demonstrating analysis, visualization and strategic
              thinking.
            </p>
          </div>

          <div class="projects-grid">
            {
              projects.map((project, index) => (
                <article class="project-card">
                  <div class="project-number">
                    {String(index + 1).padStart(2, "0")}
                  </div>

                  <div class="project-category">{project.category}</div>

                  <h3>{project.title}</h3>

                  <p>{project.description}</p>

                  <div class="project-tags">
                    {project.tags.map((tag) => <span>{tag}</span>)}
                  </div>

                  <a href={project.href} class="project-link">
                    Explore Project <span>→</span>
                  </a>
                </article>
              ))
            }
          </div>

          <!-- Featured project -->
          <article class="featured-project">
            <div class="featured-content">
              <p class="eyebrow">Featured Case Study</p>

              <h3>Customer Churn Analytics</h3>

              <p>
                A complete business intelligence case study analyzing customer
                behavior, churn patterns, service characteristics, tenure,
                contracts and customer segments.
              </p>

              <div class="featured-tags">
                <span>Power BI</span>
                <span>Python</span>
                <span>Business Analytics</span>
                <span>Customer Retention</span>
              </div>

              <a href="#contact" class="button button-primary">
                View Case Study <span>→</span>
              </a>
            </div>

            <div class="dashboard-preview">
              <div class="dashboard-header">
                <span></span>
                <span></span>
                <span></span>
              </div>

              <div class="dashboard-title"></div>

              <div class="dashboard-kpis">
                <div></div>
                <div></div>
                <div></div>
              </div>

              <div class="dashboard-charts">
                <div class="chart chart-large">
                  <i></i>
                  <i></i>
                  <i></i>
                  <i></i>
                  <i></i>
                </div>

                <div class="chart chart-small">
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- =========================
           EXPERIENCE
      ========================== -->
      <section id="experience" class="section section-soft">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">04 — Experience</p>
            <h2>Leadership with a business and social impact perspective.</h2>
          </div>

          <div class="timeline">
            <article class="timeline-item">
              <div class="timeline-year">2008 — Present</div>

              <div class="timeline-content">
                <h3>CEO & Strategic Manager</h3>
                <h4>CANU Association Cameroon</h4>

                <p>
                  Leading nonprofit initiatives focused on education,
                  humanitarian support and community development while
                  coordinating teams, budgets, partnerships and organizational
                  strategy.
                </p>

                <div class="experience-metrics">
                  <span>15+ Team Members</span>
                  <span>$50K Annual Budget</span>
                  <span>100+ Beneficiaries</span>
                </div>
              </div>
            </article>

            <article class="timeline-item">
              <div class="timeline-year">Founder</div>

              <div class="timeline-content">
                <h3>Founder & CEO</h3>
                <h4>StartSmart Africa</h4>

                <p>
                  Entrepreneurship and small business development coaching
                  focused on helping entrepreneurs build stronger businesses,
                  improve decision-making and pursue sustainable growth.
                </p>

                <div class="experience-metrics">
                  <span>Entrepreneurship</span>
                  <span>Business Strategy</span>
                  <span>SME Development</span>
                </div>
              </div>
            </article>

            <article class="timeline-item">
              <div class="timeline-year">Analytics</div>

              <div class="timeline-content">
                <h3>Business Analyst & Data Analytics</h3>
                <h4>Business Intelligence Projects</h4>

                <p>
                  Developing analytical solutions using Power BI, Excel, SQL
                  and Python to explore datasets, create dashboards, identify
                  trends and communicate actionable business insights.
                </p>

                <div class="experience-metrics">
                  <span>Power BI</span>
                  <span>SQL</span>
                  <span>Python</span>
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- =========================
           CONTACT
      ========================== -->
      <section id="contact" class="section contact-section">
        <div class="container contact-container">
          <div>
            <p class="eyebrow">05 — Contact</p>

            <h2>Let's turn your data into a business advantage.</h2>

            <p class="contact-description">
              Whether you need a business dashboard, data analysis, reporting
              solution or strategic insight, I'm open to discussing how I can
              help.
            </p>
          </div>

          <div class="contact-actions">
            <a href="mailto:your-email@example.com" class="contact-link">
              <span>Email</span>
              <strong>Get in touch →</strong>
            </a>

            <a href="#projects" class="contact-link">
              <span>Portfolio</span>
              <strong>Explore my work →</strong>
            </a>
          </div>
        </div>
      </section>
    </main>

    <!-- =========================
         FOOTER
    ========================== -->
    <footer class="footer">
      <div class="container footer-inner">
        <div>
          <strong>Suh Cheo Cyprain</strong>
          <span>Business Analyst · Data Analytics · BI</span>
        </div>

        <p>© {new Date().getFullYear()} Suh Cheo Cyprain. All rights reserved.</p>

        <a href="#home">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --navy: #0b2545;
    --navy-dark: #071a31;
    --blue: #1677ff;
    --blue-light: #4da3ff;
    --white: #ffffff;
    --off-white: #f6f8fb;
    --text: #172033;
    --muted: #687386;
    --border: #dfe5ed;
    --card: #ffffff;
    --radius: 18px;
    --container: 1180px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--text);
    background: var(--white);
    font-family: "Inter", sans-serif;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(var(--container), calc(100% - 48px));
    margin: 0 auto;
  }

  .site-header {
    position: fixed;
    z-index: 100;
    top: 0;
    right: 0;
    left: 0;
    background: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(223, 229, 237, 0.8);
    backdrop-filter: blur(16px);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 700;
  }

  .brand-mark {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    color: white;
    background: var(--navy);
    border-radius: 11px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 13px;
  }

  .brand-name {
    font-size: 15px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 27px;
    color: #4e596a;
    font-size: 13px;
    font-weight: 600;
  }

  .nav-links a {
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--blue);
  }

  .nav-cta {
    padding: 11px 17px;
    color: white;
    background: var(--navy);
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .nav-cta:hover {
    background: var(--blue);
    transform: translateY(-2px);
  }

  .hero {
    position: relative;
    display: flex;
    min-height: 850px;
    align-items: center;
    overflow: hidden;
    padding: 150px 0 100px;
    background:
      radial-gradient(circle at 80% 35%, rgba(22, 119, 255, 0.12), transparent 27%),
      linear-gradient(180deg, #f8fbff 0%, #ffffff 100%);
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    align-items: center;
    gap: 80px;
  }

  .hero-content {
    max-width: 700px;
  }

  .eyebrow {
    margin: 0 0 20px;
    color: var(--blue);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 7px;
    background: #23c483;
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(35, 196, 131, 0.1);
  }

  h1,
  h2,
  h3,
  h4 {
    margin-top: 0;
    font-family: "Space Grotesk", sans-serif;
    line-height: 1.08;
  }

  h1 {
    max-width: 780px;
    margin-bottom: 27px;
    color: var(--navy);
    font-size: clamp(48px, 6vw, 78px);
    letter-spacing: -0.055em;
  }

  .gradient-text {
    background: linear-gradient(100deg, var(--blue), #6c5ce7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-description {
    max-width: 650px;
    margin-bottom: 34px;
    color: var(--muted);
    font-size: 18px;
  }

  .hero-description strong {
    color: var(--text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    margin-bottom: 58px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    padding: 14px 20px;
    border-radius: 11px;
    font-size: 14px;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    color: white;
    background: var(--navy);
    box-shadow: 0 10px 25px rgba(11, 37, 69, 0.16);
  }

  .button-primary:hover {
    box-shadow: 0 15px 32px rgba(11, 37, 69, 0.23);
  }

  .button-secondary {
    border: 1px solid var(--border);
    background: white;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 45px;
  }

  .hero-stats div {
    display: flex;
    flex-direction: column;
  }

  .hero-stats strong {
    color: var(--navy);
    font-family: "Space Grotesk", sans-serif;
    font-size: 27px;
  }

  .hero-stats span {
    color: var(--muted);
    font-size: 11px;
  }

  .hero-card {
    display: flex;
    justify-content: center;
  }

  .profile-card {
    width: min(100%, 430px);
    padding: 32px;
    color: white;
    background:
      radial-gradient(circle at 100% 0%, rgba(77, 163, 255, 0.22), transparent 35%),
      var(--navy);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    box-shadow: 0 35px 80px rgba(11, 37, 69, 0.22);
    transform: rotate(2deg);
  }

  .profile-top {
    display: flex;
    align-items: center;
    gap: 17px;
  }

  .profile-avatar {
    display: grid;
    width: 65px;
    height: 65px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.1);
    font-family: "Space Grotesk", sans-serif;
    font-size: 20px;
    font-weight: 700;
  }

  .profile-label {
    color: #8dbbff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.13em;
  }

  .profile-top h2 {
    margin: 5px 0 0;
    font-size: 22px;
  }

  .profile-line {
    height: 1px;
    margin: 30px 0 22px;
    background: rgba(255, 255, 255, 0.12);
  }

  .profile-item {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 10px;
    padding: 15px 0;
  }

  .profile-item > span {
    color: #63a8ff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
  }

  .profile-item strong {
    font-size: 15px;
  }

  .profile-item p {
    margin: 3px 0 0;
    color: #aebbd0;
    font-size: 12px;
  }

  .profile-footer {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #9cadc4;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-glow {
    position: absolute;
    width: 450px;
    height: 450px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.3;
  }

  .hero-glow-one {
    top: -180px;
    right: 5%;
    background: #d9ebff;
  }

  .hero-glow-two {
    bottom: -250px;
    left: 5%;
    background: #e8e2ff;
  }

  .section {
    padding: 120px 0;
  }

  .section-dark {
    color: white;
    background: var(--navy-dark);
  }

  .section-soft {
    background: var(--off-white);
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 55px;
  }

  .section-heading h2 {
    margin-bottom: 0;
    color: var(--navy);
    font-size: clamp(36px, 4vw, 52px);
    letter-spacing: -0.04em;
  }

  .section-dark .section-heading h2 {
    color: white;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 90px;
  }

  .about-intro p {
    color: var(--muted);
    font-size: 16px;
  }

  .about-intro .large-text {
    color: var(--text);
    font-size: 24px;
    line-height: 1.5;
  }

  .about-details {
    display: grid;
    gap: 15px;
  }

  .detail-card {
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--off-white);
  }

  .detail-card span {
    display: block;
    margin-bottom: 7px;
    color: var(--blue);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .detail-card strong {
    display: block;
    color: var(--navy);
    font-family: "Space Grotesk", sans-serif;
    font-size: 18px;
  }

  .detail-card p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 12px;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
